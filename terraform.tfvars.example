# Uncomment when adopting an existing live Seed project & KMS KeyRing from
# platform_unified_data_gcp/infra/bootstrap without recreating resources:
# bootstrap_name    = "unified-data-platform"
# seed_folder_key   = "unified-data-platform"
# seed_project_name = "UDP Seed"
# kms_key_ring_name = "unified-data-platform-tofu-state"

# NOTE: Folder declarations live in Git-tracked `folders/<folder-key>.yaml` files
# (loaded automatically when `load_folders_from_yaml = true`, the default).
# Use `./scripts/onboard_folder.sh --open-pr` or the local `folder-onboarding` skill
# to onboard new folders or update a graduated project's `ci.github_repository`.
#
# Optional: `folders` / `subfolders` may also be supplied or overridden here.
folders    = {}
subfolders = {}

